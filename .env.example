# Copy to `.env` and adjust if your deployed demo origins differ from the
# defaults baked into apps/portfolio/src/data/projects.js.
#
# These are read at BUILD time by Vite, so they are baked into the bundle — they
# are public URLs, never secrets.
#
# Set them in the Vercel project (Settings -> Environment Variables) as well as
# locally, so a deployed build points at the deployed demos. With none set, a
# production build falls back to the demoUrl values in the data file.

# VITE_DEMO_TIMELINE_URL=https://kartikdesign-timeline.vercel.app
# VITE_DEMO_WEBGL_URL=https://kartikdesign-webgl.vercel.app
# VITE_DEMO_SEARCH_URL=https://kartikdesign-search.vercel.app
